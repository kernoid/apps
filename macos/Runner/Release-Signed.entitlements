<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Release.entitlements with the app group and the keychain group it shares with the File Provider extension
     (native/apple/Shared/SharedLogin.swift) – for a build signed by a team (Configs/Signing.xcconfig). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.kernoid.kernoid</string>
	</array>
	<!-- The app's own group first: it stays the default for what the app keeps for itself. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.kernoid.kernoid</string>
		<string>$(AppIdentifierPrefix)dev.kernoid.kernoid.shared</string>
	</array>
</dict>
</plist>
