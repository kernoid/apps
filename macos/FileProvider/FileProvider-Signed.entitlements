<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- The File Provider extension on macOS: sandboxed, talks to kernoid, shares the app group and the keychain group
     with the app (native/apple/Shared/SharedLogin.swift). The groups need a build signed by a team (Runner/Configs/Signing.xcconfig). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.kernoid.kernoid</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.kernoid.kernoid.shared</string>
	</array>
</dict>
</plist>
