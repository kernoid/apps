<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- The app on iOS: the app group and the keychain group it shares with the File Provider extension
     (native/apple/Shared/SharedLogin.swift). They need a build signed by a team (Signing.xcconfig). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.kernoid.kernoid</string>
	</array>
	<!-- The app's own group first: it stays the default for what the app keeps for itself. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.kernoid.kernoid</string>
		<string>$(AppIdentifierPrefix)dev.kernoid.kernoid.shared</string>
	</array>
</dict>
</plist>
